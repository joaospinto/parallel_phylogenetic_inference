load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "requires_cuda")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "benchmark_shell_test",
    srcs = ["tests/benchmark_shell_test.sh"],
    data = [
        "scripts/accelerator_environment.sh",
        "scripts/benchmark_empirical_manifest.sh",
        "scripts/benchmark_resume.sh",
        "scripts/capacity_bounded.sh",
        "scripts/kaggle_accelerator_notebook.sh",
        "scripts/kaggle_cuda_notebook.sh",
        "scripts/summarize_benchmarks.py",
        "tests/benchmark_report_fixture.txt",
    ],
)

sh_test(
    name = "corpus_preparation_test",
    srcs = ["tests/corpus_preparation_test.sh"],
    data = [
        "scripts/prepare_dryad_corpus.py",
        "scripts/prepare_streaming_alignment.py",
    ],
)

config_setting(
    name = "macos_fp32",
    constraint_values = ["@platforms//os:osx"],
    flag_values = {"@parallel_tree_hmm//:precision": "fp32"},
)

config_setting(
    name = "rocm_enabled_linux",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {"@parallel_tree_hmm//:enable_rocm": "true"},
)

cc_library(
    name = "parallel_phylogenetics",
    srcs = [
        "src/alignment.cc",
        "src/io.cc",
        "src/likelihood.cc",
    ],
    hdrs = [
        "include/parallel_phylogenetics/alignment.h",
        "include/parallel_phylogenetics/io.h",
        "include/parallel_phylogenetics/likelihood.h",
        "src/alignment_internal.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@bidirectional_tree_rake_compress//:btrc",
        "@parallel_tree_hmm//:tree_hmm",
    ],
)

cc_test(
    name = "likelihood_test",
    srcs = ["tests/likelihood_test.cc"],
    deps = [":parallel_phylogenetics"],
)

cc_test(
    name = "synthetic_test",
    srcs = [
        "benchmarks/benchmark.h",
        "benchmarks/synthetic.h",
        "tests/synthetic_test.cc",
    ],
    deps = [
        ":parallel_phylogenetics",
        "@bidirectional_tree_rake_compress//:btrc",
    ],
)

