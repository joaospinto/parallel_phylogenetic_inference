load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "requires_cuda")

config_setting(
    name = "macos_fp32",
    constraint_values = ["@platforms//os:osx"],
    flag_values = {"@parallel_tree_hmm//:precision": "fp32"},
)

cc_library(
    name = "parallel_phylogenetics",
    srcs = [
        "src/alignment.cc",
        "src/io.cc",
        "src/likelihood.cc",
    ],
    hdrs = [
        "include/parallel_phylogenetics/alignment.h",
        "include/parallel_phylogenetics/io.h",
        "include/parallel_phylogenetics/likelihood.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@bidirectional_tree_rake_compress//:btrc",
        "@parallel_tree_hmm//:tree_hmm",
    ],
)

cc_test(
    name = "likelihood_test",
    srcs = ["tests/likelihood_test.cc"],
    deps = [":parallel_phylogenetics"],
)

cc_library(
    name = "parallel_phylogenetics_cuda",
    srcs = [
        "src/accelerator_internal.h",
        "src/cuda.cc",
    ],
    hdrs = ["include/parallel_phylogenetics/cuda.h"],
    includes = ["include"],
    target_compatible_with = requires_cuda(),
    visibility = ["//visibility:public"],
    deps = [
        ":parallel_phylogenetics",
        "@parallel_tree_hmm//:tree_hmm_cuda",
    ],
)

cc_test(
    name = "cuda_test",
    srcs = [
        "tests/accelerator_test.h",
        "tests/cuda_test.cc",
    ],
    tags = [
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = requires_cuda(),
    deps = [
        ":parallel_phylogenetics",
        ":parallel_phylogenetics_cuda",
    ],
)

cc_library(
    name = "parallel_phylogenetics_metal",
    srcs = [
        "src/accelerator_internal.h",
        "src/metal.cc",
    ],
    hdrs = ["include/parallel_phylogenetics/metal.h"],
    includes = ["include"],
    target_compatible_with = select({
        ":macos_fp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":parallel_phylogenetics",
        "@parallel_tree_hmm//:tree_hmm_metal",
    ],
)

cc_test(
    name = "metal_test",
    srcs = [
        "tests/accelerator_test.h",
        "tests/metal_test.cc",
    ],
    target_compatible_with = select({
        ":macos_fp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":parallel_phylogenetics",
        ":parallel_phylogenetics_metal",
    ],
)

cc_binary(
    name = "metal_benchmark",
    srcs = [
        "benchmarks/benchmark.h",
        "benchmarks/metal_benchmark.cc",
    ],
    target_compatible_with = select({
        ":macos_fp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":parallel_phylogenetics",
        "@parallel_tree_hmm//:tree_hmm_metal",
    ],
)

cc_binary(
    name = "cuda_benchmark",
    srcs = [
        "benchmarks/benchmark.h",
        "benchmarks/cuda_benchmark.cc",
    ],
    target_compatible_with = requires_cuda(),
    deps = [
        ":parallel_phylogenetics",
        "@parallel_tree_hmm//:tree_hmm_cuda",
    ],
)
