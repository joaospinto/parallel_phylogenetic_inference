module(
    name = "parallel_phylogenetic_inference",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bidirectional_tree_rake_compress", version = "0.1.0")
bazel_dep(name = "parallel_tree_hmm", version = "0.1.0")

accelerator_sdks = use_extension(
    "@parallel_tree_hmm//toolchains:extensions.bzl",
    "accelerator_sdks",
)
use_repo(accelerator_sdks, "cuda", "rocm_sdk")

beagle = use_extension("//third_party/beagle:extension.bzl", "beagle")
use_repo(beagle, "beagle")

local_path_override(
    module_name = "bidirectional_tree_rake_compress",
    path = "../bidirectional_tree_rake_compress",
)
local_path_override(
    module_name = "parallel_tree_hmm",
    path = "../parallel_tree_hmm",
)
